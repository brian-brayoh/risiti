# --- Database (Neon) ---
# Pooled connection (hostname contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/risiti?sslmode=require"
# Direct (non-pooled) connection - required for prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/risiti?sslmode=require"

# --- Auth.js v5 ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# --- Public base URL (M-Pesa callback URLs + invoice links). Optional on Vercel. ---
APP_URL="http://localhost:3000"

# --- Safaricom Daraja (C2B) ---
MPESA_ENV="sandbox"               # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""

# --- Africa's Talking SMS (leave blank to log SMS to the console instead) ---
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""                   # optional approved sender ID

# --- Background jobs ---
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="replace-me"

# --- Dev tools ---
# Shows the "Simulate payment" panel. Never enable in production.
ENABLE_SIMULATOR=true
